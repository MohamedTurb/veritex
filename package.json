{
  "name": "veritex-shop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:cypress": "start-server-and-test \"npm run dev -- --port 4173\" http://localhost:4173 \"cypress run\"",
    "postman:run": "newman run tests/postman/veritex-smoke.postman_collection.json -e tests/postman/local.postman_environment.json",
    "test:postman": "start-server-and-test \"npm run dev -- --port 4173\" http://localhost:4173 \"npm run postman:run\"",
    "selenium:run": "node tests/selenium/shop.smoke.test.mjs",
    "test:selenium": "start-server-and-test \"npm run dev -- --port 4173\" http://localhost:4173 \"npm run selenium:run\""
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.22.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "cypress": "^15.14.2",
    "jsdom": "^29.0.2",
    "newman": "^6.2.2",
    "playwright": "^1.59.1",
    "postcss": "^8.4.35",
    "selenium-webdriver": "^4.43.0",
    "start-server-and-test": "^3.0.2",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.0",
    "vitest": "^4.1.5"
  }
}
